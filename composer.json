{
  "name": "solophp/inertia",
  "type": "library",
  "description": "Inertia.js 3 server adapter for PSR-7 and PSR-15: pages, partial reloads, deferred, merge and once props, flash data, history encryption and server-side rendering",
  "keywords": ["inertia", "inertiajs", "psr-7", "psr-15", "middleware", "spa", "svelte", "vue", "react"],
  "homepage": "https://github.com/SoloPHP/Inertia",
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/SoloPHP/Inertia/issues",
    "source": "https://github.com/SoloPHP/Inertia",
    "docs": "https://solophp.github.io/Inertia/"
  },
  "autoload": {
    "psr-4": {
      "Solo\\Inertia\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\Inertia\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.3",
    "psr/http-client": "^1.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "suggest": {
    "psr/http-client": "For server-side rendering with Ssr\\HttpGateway, with any PSR-18 client"
  },
  "scripts": {
    "cs": "phpcs",
    "cs-fix": "phpcbf",
    "stan": "phpstan analyse --memory-limit=512M",
    "test": "phpunit",
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
